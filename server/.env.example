# Copy this file to .env and fill it in. NEVER commit .env to GitHub.
# Postgres connection string (Neon, Render or local), e.g.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/surveyhub"

# Long random string used to sign login tokens
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=5000
# Address of the React app (for CORS)
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"
